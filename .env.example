# Copy to .env and fill in. Never commit .env.

# ACRCloud (https://console.acrcloud.com → Audio & Video Recognition project)
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Spotify (https://developer.spotify.com/dashboard). Add the redirect URI below to your app.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional: lets search_tracks work before `music-mcp auth`.
# SPOTIFY_CLIENT_SECRET=

# Optional: only allow reading audio inside this folder (recommended).
# MUSIC_MCP_AUDIO_DIR=/Users/you/Music
