# Music MCP Server - Environment Variables Template
# Bu dosyayı .env olarak kopyalayın ve kendi API anahtarlarınızla doldurun

# Spotify API Credentials
# https://developer.spotify.com/dashboard adresinden alabilirsiniz
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8002/callback

# ACRCloud API Credentials  
# https://console.acrcloud.com adresinden alabilirsiniz
ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key_here
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret_here

# Server Configuration (Opsiyonel)
SERVER_HOST=127.0.0.1
SERVER_PORT=8002
DEBUG=false